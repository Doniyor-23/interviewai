PORT=5005
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
GEMINI_API_KEY=your_gemini_api_key
# Optional Azure Speech resource; create it with the Free (F0) pricing tier.
# Keep this key on the backend only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_FREE_TIER_ONLY=false
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
CLIENT_URL=http://localhost:5173
# Optional: override the Gemini model (otherwise a fallback chain + auto-discovery is used)
# GEMINI_MODEL=
